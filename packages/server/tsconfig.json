{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".cache/tsbuild",
    "target": "ES2024",
    "tsBuildInfoFile": ".cache/tsbuild/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src", "tests", "*.config.ts"],
  "exclude": ["dist", ".cache"]
}
