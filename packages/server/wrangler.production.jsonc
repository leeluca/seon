{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seon-server",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Preserve runtime configuration managed in the Cloudflare dashboard.
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // NOTE: Resource ID only, not a database credential. Forks must replace it.
      "id": "a9a2259ec38a495095661be8fa24acf1"
    }
  ]
}
