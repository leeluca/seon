{
  "name": "server",
  "description": "",
  "main": "dist/entrypoints/node.js",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:worker",
    "validate:runtimes": "pnpm run typecheck && pnpm run test && pnpm run test:worker && pnpm run build:node && pnpm run build:worker",
    "build:node": "tsc -p tsconfig.build.json",
    "build:worker": "wrangler deploy --dry-run --outdir .cache/wrangler --metafile && pnpm run check:worker-bundle",
    "start": "node dist/entrypoints/node.js",
    "dev": "pnpm run dev:worker",
    "dev:worker": "wrangler dev",
    "dev:node": "NODE_ENV=development tsx --watch src/entrypoints/node.ts",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:worker && pnpm run types:worker:check",
    "typecheck:node": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit && tsc -p tests/worker/tsconfig.json --noEmit",
    "types:worker": "wrangler types",
    "types:worker:check": "wrangler types --check",
    "check:worker-bundle": "node scripts/check-worker-bundle.mjs",
    "deploy:worker": "wrangler deploy --config wrangler.production.jsonc",
    "lint": "biome check --write",
    "test": "vitest run",
    "test:worker": "BETTER_AUTH_SECRET=worker-test-secret-that-is-at-least-32-characters RESEND_API_KEY=worker-test-resend-key vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/typebox-validator": "^1.1.0",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
