# Node and migration database connection. Use a local database for development.
DB_URL=postgres://localhost:5432/seon

# Wrangler's local Hyperdrive target. Keep this pointed at the same local
# PostgreSQL database; production receives its connection through HYPERDRIVE.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://localhost:5432/seon

# At least 32 random characters. Rotating this signs every device out.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public URL where /api/auth is reachable. Development calls the server
# directly; production uses the web origin through the same-origin proxy.
BETTER_AUTH_URL=http://localhost:3000

# PowerSync instance audience configured for the Better Auth JWKS.
POWERSYNC_AUDIENCE=local-powersync
SYNC_URL=http://localhost:8080

# allowed browser origins for CORS and Better Auth origin checks
ORIGIN_URLS=http://localhost:5173

# resend in production; capture prints links to the development server console;
# noop disables delivery
AUTH_EMAIL_DELIVERY=capture
RESEND_API_KEY=unused-in-capture-mode
AUTH_EMAIL_FROM="Seon <auth@example.com>"
