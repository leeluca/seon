DB_URL=

# At least 32 random characters. Rotating this signs every device out.
BETTER_AUTH_SECRET=
# Public URL where /api/auth is reachable. Development calls the server
# directly; production uses the web origin through the same-origin proxy.
BETTER_AUTH_URL=http://localhost:3000

# PowerSync instance audience configured for the Better Auth JWKS.
POWERSYNC_AUDIENCE=
SYNC_URL=

# allowed browser origins for CORS and Better Auth origin checks
ORIGIN_URLS=http://localhost:5173

# resend in production; capture prints links to the development server console;
# noop disables delivery
AUTH_EMAIL_DELIVERY=capture
RESEND_API_KEY=
AUTH_EMAIL_FROM=
